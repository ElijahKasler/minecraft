{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "Eagler platform: HTTP API, static web, Eagler WebSocket bridge and Minecraft 1.8 Java proxy",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-concurrency=1 --test-force-exit test/*.test.ts"
  },
  "dependencies": {
    "@eaglerplatform/shared": "*",
    "pg": "^8.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}