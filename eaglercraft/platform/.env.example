# Copy to .env and fill in. Never commit .env.

# HTTP/WS public origin (used for OAuth redirect URIs and Play URLs)
PUBLIC_ORIGIN=http://localhost:3007
LISTEN_HOST=0.0.0.0
LISTEN_PORT=3007

# Postgres
DATABASE_URL=postgres://eagler:eagler@localhost:5432/eagler

# Session cookie
SESSION_COOKIE_NAME=sid
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false

# Secret used to encrypt OAuth refresh tokens at rest (32+ bytes hex)
ENCRYPTION_KEY=change-me-generate-64-hex-chars-0123456789abcdef

# Microsoft Entra (Azure) app for OAuth - Phase 8
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=consumers

# The first registered account automatically becomes admin.

# Client assets (built Eaglercraft output served to browsers).
# Relative paths resolve against the platform root (where this repo lives).
CLIENT_STATIC_DIR=../target_teavm_javascript/javascript

# Web SPA bundle (Vite build output). Relative to platform root.
#WEB_STATIC_DIR=apps/web/dist

# Bridge
BRIDGE_PATH=/eagler
PLAY_TICKET_TTL_SECONDS=120

# Rate limiting (per IP)
RATE_LIMIT_AUTH_PER_MIN=20